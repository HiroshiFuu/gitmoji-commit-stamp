{
  "name": "gitmoji-commit-stamp",
  "displayName": "Gitmoji Commit Stamp",
  "description": "Pick a gitmoji commit type in Source Control and stamp a prefix with emoji and branch ticket number onto the commit message",
  "version": "0.0.1",
  "publisher": "hiroshifuu",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiroshiFuu/gitmoji-commit-stamp.git"
  },
  "bugs": {
    "url": "https://github.com/HiroshiFuu/gitmoji-commit-stamp/issues"
  },
  "homepage": "https://github.com/HiroshiFuu/gitmoji-commit-stamp#readme",
  "galleryBanner": {
    "color": "#4f46e5",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "gitmoji",
    "commit",
    "emoji",
    "git",
    "commit message",
    "prefix"
  ],
  "main": "./extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitmojiCommitStamp.selectType",
        "title": "Select Commit Type",
        "category": "Gitmoji Commit Stamp",
        "icon": "$(tag)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitmojiCommitStamp.selectType",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Gitmoji Commit Stamp",
      "properties": {
        "gitmojiCommitStamp.customType": {
          "type": "array",
          "markdownDescription": "Custom commit type list. Each item has `emoji`, `type` (written into the message prefix), and `description`.",
          "items": {
            "type": "object",
            "required": [
              "emoji",
              "type",
              "description"
            ],
            "properties": {
              "emoji": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "emoji": "✨",
              "type": "feat",
              "description": "Introduce new features."
            },
            {
              "emoji": "🐛",
              "type": "fix",
              "description": "Fix a bug."
            },
            {
              "emoji": "✅",
              "type": "test",
              "description": "Add, update, or pass tests."
            },
            {
              "emoji": "📝",
              "type": "docs",
              "description": "Add or update documentation."
            },
            {
              "emoji": "♻️",
              "type": "refactor",
              "description": "Refactor code."
            },
            {
              "emoji": "🎨",
              "type": "style",
              "description": "Improve structure / format of the code."
            },
            {
              "emoji": "⚡️",
              "type": "perf",
              "description": "Improve performance."
            },
            {
              "emoji": "🔥",
              "type": "refactor",
              "description": "Remove code or files."
            },
            {
              "emoji": "🚑️",
              "type": "fix",
              "description": "Critical hotfix."
            },
            {
              "emoji": "🚀",
              "type": "chore",
              "description": "Deploy stuff."
            },
            {
              "emoji": "💄",
              "type": "style",
              "description": "Add or update the UI and style files."
            },
            {
              "emoji": "🎉",
              "type": "chore",
              "description": "Begin a project."
            },
            {
              "emoji": "🔒️",
              "type": "fix",
              "description": "Fix security or privacy issues."
            },
            {
              "emoji": "🔐",
              "type": "chore",
              "description": "Add or update secrets."
            },
            {
              "emoji": "🔖",
              "type": "chore",
              "description": "Release / Version tags."
            },
            {
              "emoji": "🚨",
              "type": "style",
              "description": "Fix compiler / linter warnings."
            },
            {
              "emoji": "🚧",
              "type": "chore",
              "description": "Work in progress."
            },
            {
