            }
          ]
        },
        "gitmojiCommitStamp.ticketPrefix": {
          "type": "string",
          "default": "RADAR",
          "markdownDescription": "Ticket number prefix. When the branch name matches `<type>/<prefix>-<digits>`, the commit message is prefixed with `<prefix>-<digits> `."
        },
        "gitmojiCommitStamp.ticketPattern": {
          "type": "string",
          "default": "^[^/]+/(${prefix}-\\d+)",
          "markdownDescription": "Regular expression to extract the ticket number from the branch name; the first capture group is used as the commit message prefix. `${prefix}` is replaced with the (regex-escaped) value of `#gitmojiCommitStamp.ticketPrefix#`."
        }
      }
    }
  }
}
