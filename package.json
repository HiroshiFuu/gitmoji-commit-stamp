{
  "name": "gitmoji-commit-stamp",
  "displayName": "Gitmoji Commit Stamp",
  "description": "Pick a gitmoji commit type in Source Control and stamp a prefix with emoji and branch ticket number onto the commit message",
  "version": "0.0.1",
  "publisher": "hiroshifuu",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiroshiFuu/gitmoji-commit-stamp.git"
  },
  "bugs": {
    "url": "https://github.com/HiroshiFuu/gitmoji-commit-stamp/issues"
  },
  "homepage": "https://github.com/HiroshiFuu/gitmoji-commit-stamp#readme",
  "galleryBanner": {
    "color": "#4f46e5",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "gitmoji",
    "commit",
    "emoji",
    "git",
    "commit message",
    "prefix"
  ],
  "main": "./extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitmojiCommitStamp.selectType",
        "title": "Select Commit Type",
        "category": "Gitmoji Commit Stamp",
        "icon": "$(tag)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitmojiCommitStamp.selectType",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Gitmoji Commit Stamp",
      "properties": {
        "gitmojiCommitStamp.customType": {
          "type": "array",
          "markdownDescription": "Custom commit type list. Each item has `emoji`, `type`, `name` (optional `description`).",
          "items": {
            "type": "object",
            "required": [
              "emoji",
              "type",
              "name"
            ],
            "properties": {
              "emoji": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "emoji": "✨",
              "type": "sparkles",
              "name": "Introduce new features."
            },
            {
              "emoji": "🐛",
              "type": "bug",
              "name": "Fix a bug."
            },
            {
              "emoji": "✅",
              "type": "white-check-mark",
              "name": "Add, update, or pass tests."
            },
            {
              "emoji": "📝",
              "type": "memo",
              "name": "Add or update documentation."
            },
            {
              "emoji": "🎨",
              "type": "art",
              "name": "Improve structure / format of the code."
            },
            {
              "emoji": "⚡️",
              "type": "zap",
              "name": "Improve performance."
            },
            {
              "emoji": "🔥",
              "type": "fire",
              "name": "Remove code or files."
            },
            {
              "emoji": "🚑️",
              "type": "ambulance",
              "name": "Critical hotfix."
            },
            {
              "emoji": "🚀",
              "type": "rocket",
              "name": "Deploy stuff."
            },
            {
              "emoji": "💄",
              "type": "lipstick",
              "name": "Add or update the UI and style files."
            },
            {
              "emoji": "🎉",
              "type": "tada",
              "name": "Begin a project."
            },
            {
              "emoji": "🔒️",
              "type": "lock",
              "name": "Fix security or privacy issues."
            },
            {
              "emoji": "🔐",
              "type": "closed-lock-with-key",
              "name": "Add or update secrets."
            },
            {
              "emoji": "🔖",
              "type": "bookmark",
              "name": "Release / Version tags."
            },
            {
